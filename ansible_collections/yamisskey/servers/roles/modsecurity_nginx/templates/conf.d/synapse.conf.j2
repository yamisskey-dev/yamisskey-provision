# ModSecurity-Nginx configuration for Matrix Synapse
# This file is included in the main ModSecurity-Nginx container

# Upstream definition
upstream synapse_backend {
    server localhost:{{ host_services.balthasar.synapse }};
    keepalive 16;
}

# Server block for Matrix Synapse
server {
    listen {{ modsecurity_nginx_port | default(8080) }};
    http2 on;
    server_name {{ synapse_server_name }};

    # Error page handling - redirect to maintenance page when backend is down
    error_page 502 503 504 @maintenance_redirect;

    # Maintenance page redirect location
    location @maintenance_redirect {
        return 302 https://down.yami.ski;
    }

    # Security headers (included from shared config to ensure inheritance in all locations)
    include /etc/nginx/conf.d/00-security-headers-deny.conf;

    # CORS headers for Matrix federation
    add_header 'Access-Control-Allow-Origin' '*' always;
    add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, PUT, DELETE' always;
    add_header 'Access-Control-Allow-Headers' 'Authorization, Origin, X-Requested-With, Content-Type, Accept' always;
    add_header 'Access-Control-Allow-Credentials' 'true' always;

    # Proxy settings
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    # WebSocket support
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # Well-known endpoints for Matrix federation
    location /.well-known/matrix/server {
        alias /var/www/synapse/.well-known/matrix/server;
        default_type application/json;
        # Security headers (must be included in location blocks that use add_header)
        include /etc/nginx/conf.d/00-security-headers-deny.conf;
        # CORS is already included in server-level headers
    }

    # Served inline: the ModSecurity-Nginx container does not mount the Synapse
    # well-known dir, so the alias 404s. Keep in sync with the matrix role's
    # synapse_well_known_client.json.j2 — org.matrix.msc4143.rtc_foci points
    # Element Call (MatrixRTC) at the self-hosted LiveKit backend.
    location = /.well-known/matrix/client {
        default_type application/json;
        add_header 'Access-Control-Allow-Origin' '*' always;
        return 200 '{"m.homeserver":{"base_url":"https://{{ synapse_server_name }}","server_name":"{{ synapse_server_name }}"},"m.identity_server":{"base_url":"https://vector.im"},"org.matrix.msc4143.rtc_foci":[{"type":"livekit","livekit_service_url":"https://{{ livekit_jwt_server_name }}"}]}';
    }

    # Main Matrix endpoints
    location ~* ^/_matrix/ {
        proxy_pass http://synapse_backend;
        proxy_http_version 1.1;

        # Long timeouts for Matrix sync
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;

        # Matrix-specific headers
        proxy_set_header X-Forwarded-Protocol $scheme;
        proxy_set_header X-Forwarded-SSL on;

        # API cache for non-sync endpoints
        proxy_cache api_cache;
        proxy_cache_methods GET HEAD;
        proxy_cache_valid 200 1m;
        proxy_cache_valid 404 30s;
        proxy_cache_use_stale error timeout updating;
        proxy_cache_key "$scheme$request_method$host$request_uri";

        # Security headers (must be included in location blocks that use add_header)
        include /etc/nginx/conf.d/00-security-headers-deny.conf;
        add_header X-Cache-Status $upstream_cache_status;
    }

    # Synapse admin API
    location ~* ^/_synapse/ {
        proxy_pass http://synapse_backend;
        proxy_http_version 1.1;
        proxy_buffering off;
    }

    # Default location
    location / {
        proxy_pass http://synapse_backend;
        proxy_http_version 1.1;
        proxy_buffering off;

        # Light caching for Matrix content
        proxy_cache api_cache;
        proxy_cache_valid 200 30s;
        proxy_cache_valid 404 10s;
        proxy_cache_use_stale error timeout updating;
        proxy_cache_key "$scheme$request_method$host$request_uri";

        # Security headers (must be included in location blocks that use add_header)
        include /etc/nginx/conf.d/00-security-headers-deny.conf;
        add_header X-Cache-Status $upstream_cache_status;
    }
}
