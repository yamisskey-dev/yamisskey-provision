# Garage Nginx Proxy Configuration
# Dual backend: S3 API (3900) for authenticated ops, Web (3902) for public reads

# Rate limiting
limit_req_zone $binary_remote_addr zone=garage_general:20m rate=500r/m;
limit_req_zone $binary_remote_addr zone=garage_burst:10m rate=1000r/m;

# S3 API backend (authenticated requests from Misskey)
upstream garage_api_backend {
    server 127.0.0.1:{{ host_services.balthasar.garage_api | default('3900') }} weight=1 max_fails=3 fail_timeout=10s;
    keepalive 64;
    keepalive_requests 1000;
    keepalive_timeout 60s;
}

# Web endpoint backend (public reads, no auth required)
upstream garage_web_backend {
    server 127.0.0.1:{{ host_services.balthasar.garage_web | default('3902') }} weight=1 max_fails=3 fail_timeout=10s;
    keepalive 32;
    keepalive_requests 1000;
    keepalive_timeout 60s;
}

server {
    listen {{ modsecurity_nginx_port | default(8080) }};
    http2 on;
    server_name {{ garage_api_server_name }};

    # TCP tuning
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 75;
    reset_timedout_connection on;

    # Rate limiting
    limit_req zone=garage_general burst=100 nodelay;
    limit_req zone=garage_burst burst=200 nodelay;

    # Error handling
    error_page 502 503 504 /50x.html;
    location = /50x.html {
        return 502 "Garage service temporarily unavailable";
    }

    # File upload settings
    client_max_body_size 1G;
    client_body_timeout 300s;

    # Security headers
    include /etc/nginx/conf.d/00-security-headers-deny.conf;
    add_header X-Robots-Tag "noindex, nofollow" always;

    # Common proxy headers
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    # Root path
    location = / {
        return 403 "Direct access not allowed";
    }

    # === /files/ path: dual routing based on Authorization header ===
    # Authenticated (Misskey S3 ops) → S3 API (port {{ host_services.balthasar.garage_api | default('3900') }})
    # Unauthenticated (browser/federation reads) → Web endpoint (port {{ host_services.balthasar.garage_web | default('3902') }})
    location /files/ {
        error_page 418 = @s3api_files;
        if ($http_authorization != "") {
            return 418;
        }

        # Public reads: strip /files/ prefix, proxy to Garage web endpoint
        # Host header set to bucket name so Garage resolves the correct bucket
        rewrite ^/files/(.*)$ /$1 break;
        proxy_pass http://garage_web_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host files;

        # Aggressive caching for public content
        proxy_cache media_cache;
        proxy_cache_valid 200 304 60d;
        proxy_cache_valid 404 1d;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 1s;
        proxy_cache_background_update on;
        proxy_cache_min_uses 1;

        expires 60d;
        include /etc/nginx/conf.d/00-security-headers-deny.conf;
        add_header Cache-Control "public, immutable, max-age=5184000";
        add_header X-Cache-Status $upstream_cache_status;

        proxy_connect_timeout 3s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        proxy_buffering on;
        proxy_buffer_size 512k;
        proxy_buffers 16 1m;
        proxy_busy_buffers_size 2m;
        proxy_request_buffering off;
        proxy_intercept_errors off;
    }

    # Named location for authenticated S3 API requests to /files/
    location @s3api_files {
        proxy_pass http://garage_api_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;

        # S3 API headers
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Amz-Content-Sha256 $http_x_amz_content_sha256;
        proxy_set_header X-Amz-Date $http_x_amz_date;
        proxy_set_header X-Amz-Security-Token $http_x_amz_security_token;
        proxy_set_header Content-Type $content_type;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_connect_timeout 3s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;

        proxy_buffering on;
        proxy_buffer_size 256k;
        proxy_buffers 8 512k;
        proxy_busy_buffers_size 1m;
        proxy_request_buffering off;
        proxy_intercept_errors off;
    }

    # S3 API for all other paths (bucket operations, listing, etc.)
    location / {
        # Only authenticated S3 clients
        if ($http_authorization = "") {
            return 403 "Authentication required";
        }

        proxy_pass http://garage_api_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;

        # S3 API headers
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Amz-Content-Sha256 $http_x_amz_content_sha256;
        proxy_set_header X-Amz-Date $http_x_amz_date;
        proxy_set_header X-Amz-Security-Token $http_x_amz_security_token;
        proxy_set_header Content-Type $content_type;

        proxy_connect_timeout 3s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        proxy_buffering on;
        proxy_buffer_size 256k;
        proxy_buffers 8 512k;
        proxy_busy_buffers_size 1m;
        proxy_request_buffering off;
        proxy_intercept_errors off;
    }

    # Compression
    gzip on;
    gzip_types
        application/json
        application/xml
        text/xml
        text/plain
        application/octet-stream;
    gzip_proxied any;
    gzip_vary on;
    gzip_min_length 128;
    gzip_buffers 16 8k;
    gzip_comp_level 6;
    gzip_disable "msie6";

    # Open file cache
    open_file_cache max=10000 inactive=30s;
    open_file_cache_valid 60s;
    open_file_cache_min_uses 2;
    open_file_cache_errors on;

    # Performance tuning
    send_timeout 30s;
    client_header_timeout 10s;
    sendfile on;
    sendfile_max_chunk 2m;
    client_header_buffer_size 4k;
    large_client_header_buffers 4 16k;

    # Logging
    access_log off;
    error_log /dev/null crit;
}
