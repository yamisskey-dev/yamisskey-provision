services:
  openclaw-gateway:
    image: {{ openclaw_image }}
    restart: unless-stopped
    init: true
    network_mode: host
    environment:
      HOME: /home/node
      TERM: xterm-256color
    env_file:
      - .env-docker-compose
    volumes:
      - {{ openclaw_dir }}/config:/home/node/.openclaw
      - {{ openclaw_dir }}/workspace:/home/node/.openclaw/workspace
    command:
      - "node"
      - "dist/index.js"
      - "gateway"
      - "--bind"
      - "{{ openclaw_gateway_bind }}"
      - "--port"
      - "{{ openclaw_gateway_port }}"
