FROM {{ openclaw_sandbox_base_image | default('debian:bookworm-slim') }}

# System packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    python3 \
    curl wget openssh-client ca-certificates gnupg \
    jq unzip zip xz-utils file \
    sqlite3 dnsutils netcat-openbsd procps \
    traceroute whois mtr-tiny \
    shellcheck \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Modern CLI tools (.deb)
RUN ARCH=$(dpkg --print-architecture) \
    && curl -fsSL "https://github.com/BurntSushi/ripgrep/releases/download/14.1.1/ripgrep_14.1.1-1_${ARCH}.deb" -o /tmp/rg.deb \
    && curl -fsSL "https://github.com/sharkdp/fd/releases/download/v10.2.0/fd_10.2.0_${ARCH}.deb" -o /tmp/fd.deb \
    && dpkg -i /tmp/*.deb && rm /tmp/*.deb

# Modern CLI tools (binary)
RUN ARCH=$(dpkg --print-architecture) \
    && curl -fsSL "https://github.com/mikefarah/yq/releases/download/v4.44.6/yq_linux_${ARCH}" -o /usr/local/bin/yq \
    && chmod +x /usr/local/bin/yq
# uv + ruff (Python tooling)
RUN ARCH=$(uname -m) \
    && curl -fsSL "https://github.com/astral-sh/uv/releases/download/0.5.24/uv-${ARCH}-unknown-linux-musl.tar.gz" \
    | tar xz --strip-components=1 -C /usr/local/bin "uv-${ARCH}-unknown-linux-musl/uv" "uv-${ARCH}-unknown-linux-musl/uvx" \
    && curl -fsSL "https://github.com/astral-sh/ruff/releases/download/0.9.6/ruff-${ARCH}-unknown-linux-musl.tar.gz" \
    | tar xz --strip-components=1 -C /usr/local/bin "ruff-${ARCH}-unknown-linux-musl/ruff"

# GitHub CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# Go
RUN ARCH=$(dpkg --print-architecture) \
    && curl -fsSL "https://go.dev/dl/go1.23.6.linux-${ARCH}.tar.gz" | tar xz -C /usr/local \
    && ln -s /usr/local/go/bin/* /usr/local/bin/
ENV PATH="/usr/local/go/bin:${PATH}"

# Node.js + pnpm via corepack
RUN curl -fsSL https://deb.nodesource.com/setup_{{ openclaw_node_version | default('22') }}.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable

# Docker CLI (for DooD container orchestration)
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y --no-install-recommends docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

# Non-root user
RUN useradd -m -s /bin/bash claw
USER claw
ENV GOPATH="/home/claw/go"
ENV PATH="${GOPATH}/bin:${PATH}"
WORKDIR /home/claw/workspace
