{
  "meta": {
    "lastTouchedVersion": "{{ openclaw_version | default('2026.2.9') }}"
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "maxConcurrent": {{ openclaw_max_concurrent | default(4) }},
      "subagents": {
        "maxConcurrent": {{ openclaw_subagents_max_concurrent | default(8) }}
      },
      "model": {
        "primary": "{{ openclaw_default_model | default('kimi/kimi-for-coding') }}"
      }
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto"
  },
  "channels": {
    "discord": {
      "enabled": true,
      "token": "${DISCORD_BOT_TOKEN}",
      "groupPolicy": "open",
      "dm": {
        "policy": "disabled"
      },
      "historyLimit": 20,
      "replyToMode": "off",
      "commands": {
        "native": "auto"
      }
    },
    "matrix": {
      "enabled": true,
      "homeserver": "{{ openclaw_matrix_homeserver }}",
      "userId": "@openclaw:matrix.{{ domain }}",
      "password": "${MATRIX_PASSWORD}",
      "encryption": true,
      "deviceName": "OpenClaw Gateway",
      "dm": {
        "policy": "pairing"
      },
      "groupPolicy": "open",
      "autoJoin": true
    }
  },
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "gateway": {
    "mode": "{{ openclaw_gateway_mode | default('local') }}",
    "trustedProxies": ["127.0.0.1"],
    "tailscale": {
      "mode": "serve"
    },
    "auth": {
      "allowTailscale": true
    },
    "controlUi": {
      "enabled": true,
      "allowInsecureAuth": true
    }
  },
  "plugins": {
    "entries": {
      "discord": {
        "enabled": true
      },
      "matrix": {
        "enabled": true
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "kimi": {
        "baseUrl": "{{ openclaw_kimi_base_url | default('https://api.kimi.com/coding/v1') }}",
        "apiKey": "${KIMI_API_KEY}",
        "api": "openai-completions",
        "headers": {
          "User-Agent": "claude-code/1.0"
        },
        "models": [
          {
            "id": "kimi-for-coding",
            "name": "Kimi For Coding",
            "contextWindow": 262144,
            "maxTokens": 8192
          }
        ]
      }
    }
  }
}
