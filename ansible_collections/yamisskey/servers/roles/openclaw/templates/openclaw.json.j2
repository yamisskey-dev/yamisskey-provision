{
  "meta": {
    "lastTouchedVersion": "{{ openclaw_version | default('2026.2.9') }}"
  },
  "agents": {
    "defaults": {
      "model": "{{ openclaw_default_model | default('moonshot/kimi-k2.5') }}",
      "workspace": "/home/node/.openclaw/workspace",
      "maxConcurrent": {{ openclaw_max_concurrent | default(4) }},
      "subagents": {
        "maxConcurrent": {{ openclaw_subagents_max_concurrent | default(8) }}
      }
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto"
  },
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "gateway": {
    "mode": "{{ openclaw_gateway_mode | default('local') }}",
    "trustedProxies": "{{ openclaw_trusted_proxies | default('172.16.0.0/12') }}",
    "controlUi": {
      "enabled": true,
      "allowInsecureAuth": true
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "moonshot": {
        "baseUrl": "{{ openclaw_moonshot_base_url | default('https://api.moonshot.ai/v1') }}",
        "apiKey": "${KIMI_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "kimi-k2.5",
            "name": "Kimi K2.5",
            "contextWindow": 256000,
            "maxTokens": 8192
          }
        ]
      }
    }
  }
}
