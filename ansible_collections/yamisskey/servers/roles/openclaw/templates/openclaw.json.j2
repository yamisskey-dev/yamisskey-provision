{
  "meta": {
    "lastTouchedVersion": "{{ openclaw_version | default('2026.2.9') }}"
  },
  "agents": {
    "list": [
      {
        "id": "main",
        "default": true,
        "identity": {
          "emoji": "🧸",
          "avatar": "openclaw_avatar.png"
        }
      }
    ],
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "maxConcurrent": {{ openclaw_max_concurrent | default(4) }},
      "subagents": {
        "maxConcurrent": {{ openclaw_subagents_max_concurrent | default(8) }},
        "model": "{{ openclaw_subagents_model | default('openai/gpt-4o') }}"
      },
      "model": {
        "primary": "{{ openclaw_default_model | default('kimi/kimi-for-coding') }}",
        "fallbacks": {{ openclaw_model_fallbacks | default('["openai/gpt-4o"]') }}
      },
      "memorySearch": {
        "enabled": true,
        "provider": "openai"
      }
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto"
  },
  "channels": {
    "discord": {
      "enabled": true,
      "token": "${DISCORD_BOT_TOKEN}",
      "groupPolicy": "open",
      "dm": {
        "policy": "disabled"
      },
      "historyLimit": 20,
      "replyToMode": "off",
      "commands": {
        "native": "auto"
      }
    },
    "matrix": {
      "enabled": true,
      "homeserver": "{{ openclaw_matrix_homeserver }}",
      "userId": "@openclaw:matrix.{{ domain }}",
      "password": "${MATRIX_PASSWORD}",
      "encryption": true,
      "deviceName": "OpenClaw Gateway",
      "dm": {
        "policy": "pairing"
      },
      "groupPolicy": "open",
      "autoJoin": true,
      "threadReplies": "{{ openclaw_matrix_thread_replies | default('inbound') }}"
    }
  },
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "session": {
    "dmScope": "{{ openclaw_session_dm_scope | default('per-channel-peer') }}",
    "reset": {
      "mode": "{{ openclaw_session_reset_mode | default('idle') }}",
      "idleMinutes": {{ openclaw_session_idle_minutes | default(1440) }}
    }
  },
  "logging": {
    "redactSensitive": "{{ openclaw_logging_redact | default('tools') }}"
  },
  "gateway": {
    "mode": "{{ openclaw_gateway_mode | default('local') }}",
    "trustedProxies": ["127.0.0.1", "::1", "::ffff:127.0.0.1"],
    "tailscale": {
      "mode": "serve"
    },
    "auth": {
      "allowTailscale": true
    },
    "controlUi": {
      "enabled": true,
      "allowInsecureAuth": true
    }
  },
  "plugins": {
    "allow": ["discord", "matrix"],
    "entries": {
      "discord": {
        "enabled": true
      },
      "matrix": {
        "enabled": true
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "kimi": {
        "baseUrl": "{{ openclaw_kimi_base_url | default('https://api.kimi.com/coding/v1') }}",
        "apiKey": "${KIMI_API_KEY}",
        "api": "openai-completions",
        "headers": {
          "User-Agent": "claude-code/1.0"
        },
        "models": [
          {
            "id": "kimi-for-coding",
            "name": "Kimi For Coding",
            "contextWindow": 262144,
            "maxTokens": 8192
          }
        ]
      },
      "openai": {
        "baseUrl": "{{ openclaw_openai_base_url | default('https://api.openai.com/v1') }}",
        "apiKey": "${OPENAI_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "gpt-4o",
            "name": "GPT-4o",
            "contextWindow": 128000,
            "maxTokens": 16384
          }
        ]
      }
    }
  }
}
