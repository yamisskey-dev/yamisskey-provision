{
  "meta": {
    "lastTouchedVersion": "{{ openclaw_version | default('2026.6.5') }}"
  },
  "agents": {
    "list": [
      {
        "id": "main",
        "default": true,
        "sandbox": {
          "mode": "{{ openclaw_agent_sandbox_mode | default('non-main') }}",
          "scope": "agent",
          "workspaceAccess": "{{ openclaw_agent_workspace_access | default('rw') }}",
          "docker": {
            "image": "{{ openclaw_sandbox_image_name | default('openclaw-sandbox') }}:latest",
            "network": "{{ openclaw_sandbox_network | default('bridge') }}",
            "pidsLimit": {{ openclaw_sandbox_pids_limit | default(1024) }},
            "memory": "{{ openclaw_sandbox_memory | default('4g') }}"
          }
        },
        "tools": {
          "deny": {{ openclaw_agent_tools_deny | default('["browser"]') }}
        }
      }
    ],
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "thinkingDefault": "{{ openclaw_thinking_default | default('high') }}",
      "maxConcurrent": {{ openclaw_max_concurrent | default(8) }},
      "subagents": {
        "maxConcurrent": {{ openclaw_subagents_max_concurrent | default(16) }},
        "model": "{{ openclaw_subagents_model | default('opencode-go/deepseek-v4-flash') }}"
      },
      "model": {
        "primary": "{{ openclaw_default_model | default('opencode-go/deepseek-v4-pro') }}",
        "fallbacks": {{ openclaw_model_fallbacks | default('["openai/gpt-5.5"]') }}
      },
      "models": {
        "opencode-go/deepseek-v4-pro": { "alias": "ds" },
        "opencode-go/deepseek-v4-flash": { "alias": "ds-flash" },
        "openai/gpt-5.5": { "alias": "codex" },
        "openai/gpt-5.4": { "alias": "codex-prev" }
      },
      "memorySearch": {
        "enabled": true,
        "provider": "openai"
      },
      "contextPruning": {
        "mode": "{{ openclaw_context_pruning_mode | default('cache-ttl') }}",
        "ttl": "{{ openclaw_context_pruning_ttl | default('12h') }}",
        "keepLastAssistants": {{ openclaw_context_pruning_keep | default(3) }}
      },
      "compaction": {
        "mode": "{{ openclaw_compaction_mode | default('safeguard') }}",
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": {{ openclaw_compaction_flush_threshold | default(60000) }}
        }
      },
      "heartbeat": {
        "every": "{{ openclaw_heartbeat_every | default('55m') }}",
        "model": "{{ openclaw_heartbeat_model | default('opencode-go/deepseek-v4-flash') }}",
        "target": "{{ openclaw_heartbeat_target | default('telegram') }}",
        "prompt": "{{ openclaw_heartbeat_prompt | default('Read HEARTBEAT.md if it exists. Then: (1) Review .learnings/ for recurring patterns (recurrence >= 3) and promote to project memory. (2) Check for unresolved errors and attempt safe fixes. (3) If a conversation was left mid-task, summarize status. (4) If nothing needs attention, reply HEARTBEAT_OK. If HEARTBEAT.md does not exist, create it with your own improvement checklist, then reply HEARTBEAT_OK.') }}",
        "activeHours": {
          "start": "{{ openclaw_heartbeat_active_start | default('07:00') }}",
          "end": "{{ openclaw_heartbeat_active_end | default('01:00') }}",
          "timezone": "{{ openclaw_heartbeat_timezone | default('Asia/Tokyo') }}"
        }
      }
    }
  },
  "auth": {
    "profiles": {
      "openai:default": {
        "provider": "openai",
        "mode": "oauth"
      }
    }
  },
  "skills": {},
  "commands": {
    "native": "auto",
    "nativeSkills": "auto"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "pairing",
      "groupPolicy": "open",
      "commands": {
        "native": "auto"
      },
      "groups": {
        "*": {
          "requireMention": {{ openclaw_telegram_require_mention | default('false') | lower }}
        }
      }
    }
  },
  "messages": {
    "ackReactionScope": "all"
  },
  "session": {
    "dmScope": "{{ openclaw_session_dm_scope | default('per-channel-peer') }}",
    "reset": {
      "mode": "{{ openclaw_session_reset_mode | default('idle') }}",
      "idleMinutes": {{ openclaw_session_idle_minutes | default(10080) }}
    }
  },
  "logging": {
    "redactSensitive": "{{ openclaw_logging_redact | default('tools') }}",
    "redactPatterns": {{ openclaw_logging_redact_patterns | default('["token:", "password:", "apiKey:", "secret:", "Authorization:"]') }}
  },
  "gateway": {
    "mode": "{{ openclaw_gateway_mode | default('local') }}",
    "bind": "{{ openclaw_gateway_bind | default('loopback') }}",
    "port": {{ openclaw_gateway_port | default(18789) }},
    "trustedProxies": ["127.0.0.1", "::1", "::ffff:127.0.0.1"],
    "tailscale": {
      "mode": "{{ openclaw_tailscale_mode | default('serve') }}"
    },
    "auth": {
      "mode": "{{ openclaw_gateway_auth_mode | default('token') }}",
      "token": "${OPENCLAW_GATEWAY_TOKEN}",
      "allowTailscale": true
    },
    "controlUi": {
      "enabled": true,
      "allowInsecureAuth": {{ openclaw_allow_insecure_auth | default('false') | lower }},
      "dangerouslyDisableDeviceAuth": {{ openclaw_disable_device_auth | default('false') | lower }}
    }
  },
  "discovery": {
    "mdns": {
      "mode": "{{ openclaw_mdns_mode | default('off') }}"
    }
  },
  "plugins": {
    "allow": ["telegram", "codex", "openai"],
    "entries": {
      "telegram": {
        "enabled": true
      },
      "codex": {
        "enabled": true
      },
      "openai": {
        "enabled": true
      }
    }
  },
  "models": {
    "mode": "merge"
  }
}
