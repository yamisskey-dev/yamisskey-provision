{
  "meta": {
    "lastTouchedVersion": "{{ openclaw_version | default('2026.2.9') }}"
  },
  "agents": {
    "list": [
      {
        "id": "main",
        "default": true,
        "sandbox": {
          "mode": "{{ openclaw_agent_sandbox_mode | default('non-main') }}",
          "scope": "agent",
          "workspaceAccess": "{{ openclaw_agent_workspace_access | default('rw') }}",
          "docker": {
            "image": "{{ openclaw_sandbox_image_name | default('openclaw-sandbox') }}:latest",
            "network": "{{ openclaw_sandbox_network | default('bridge') }}",
            "pidsLimit": {{ openclaw_sandbox_pids_limit | default(1024) }},
            "memory": "{{ openclaw_sandbox_memory | default('4g') }}"
          }
        },
        "tools": {
          "deny": {{ openclaw_agent_tools_deny | default('["browser"]') }}
        }
      }
    ],
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "maxConcurrent": {{ openclaw_max_concurrent | default(8) }},
      "subagents": {
        "maxConcurrent": {{ openclaw_subagents_max_concurrent | default(16) }},
        "model": "{{ openclaw_subagents_model | default('openai-codex/gpt-5.1-codex-mini') }}"
      },
      "model": {
        "primary": "{{ openclaw_default_model | default('openai-codex/gpt-5.3-codex') }}",
        "fallbacks": {{ openclaw_model_fallbacks | default('["openrouter/deepseek/deepseek-v3.2", "anthropic/claude-opus-4-6"]') }}
      },
      "models": {
        "openai-codex/gpt-5.3-codex": { "alias": "codex" },
        "openai-codex/gpt-5.1-codex-mini": { "alias": "mini" },
        "anthropic/claude-opus-4-6": { "alias": "opus" },
        "anthropic/claude-sonnet-4-6": { "alias": "sonnet" },
        "openrouter/deepseek/deepseek-v3.2": { "alias": "ds" }
      },
      "memorySearch": {
        "enabled": true,
        "provider": "openai"
      },
      "contextPruning": {
        "mode": "{{ openclaw_context_pruning_mode | default('cache-ttl') }}",
        "ttl": "{{ openclaw_context_pruning_ttl | default('24h') }}",
        "keepLastAssistants": {{ openclaw_context_pruning_keep | default(5) }}
      },
      "compaction": {
        "mode": "{{ openclaw_compaction_mode | default('default') }}",
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": {{ openclaw_compaction_flush_threshold | default(80000) }}
        }
      },
      "heartbeat": {
        "every": "{{ openclaw_heartbeat_every | default('30m') }}",
        "model": "{{ openclaw_heartbeat_model | default('openai-codex/gpt-5.1-codex-mini') }}",
        "target": "{{ openclaw_heartbeat_target | default('none') }}",
        "activeHours": {
          "start": "{{ openclaw_heartbeat_active_start | default('09:00') }}",
          "end": "{{ openclaw_heartbeat_active_end | default('17:00') }}",
          "timezone": "{{ openclaw_heartbeat_timezone | default('Asia/Tokyo') }}"
        }
      }
    }
  },
  "auth": {
    "profiles": {
      "openai-codex:default": {
        "provider": "openai-codex",
        "mode": "oauth"
      }
    }
  },
  "skills": {},
  "commands": {
    "native": "auto",
    "nativeSkills": "auto"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "pairing",
      "groupPolicy": "open",
      "commands": {
        "native": "auto"
      },
      "groups": {
        "*": {
          "requireMention": {{ openclaw_telegram_require_mention | default('false') | lower }}
        }
      }
    }
  },
  "messages": {
    "ackReactionScope": "all"
  },
  "session": {
    "dmScope": "{{ openclaw_session_dm_scope | default('per-channel-peer') }}",
    "reset": {
      "mode": "{{ openclaw_session_reset_mode | default('idle') }}",
      "idleMinutes": {{ openclaw_session_idle_minutes | default(4320) }}
    }
  },
  "logging": {
    "redactSensitive": "{{ openclaw_logging_redact | default('tools') }}",
    "redactPatterns": {{ openclaw_logging_redact_patterns | default('["token:", "password:", "apiKey:", "secret:", "Authorization:"]') }}
  },
  "gateway": {
    "mode": "{{ openclaw_gateway_mode | default('local') }}",
    "bind": "{{ openclaw_gateway_bind | default('loopback') }}",
    "port": {{ openclaw_gateway_port | default(18789) }},
    "trustedProxies": ["127.0.0.1", "::1", "::ffff:127.0.0.1"],
    "tailscale": {
      "mode": "{{ openclaw_tailscale_mode | default('serve') }}"
    },
    "auth": {
      "mode": "{{ openclaw_gateway_auth_mode | default('token') }}",
      "token": "${OPENCLAW_GATEWAY_TOKEN}",
      "allowTailscale": true
    },
    "controlUi": {
      "enabled": true,
      "allowInsecureAuth": {{ openclaw_allow_insecure_auth | default('true') | lower }},
      "dangerouslyDisableDeviceAuth": {{ openclaw_disable_device_auth | default('true') | lower }}
    }
  },
  "discovery": {
    "mdns": {
      "mode": "{{ openclaw_mdns_mode | default('off') }}"
    }
  },
  "plugins": {
    "allow": ["telegram"],
    "entries": {
      "telegram": {
        "enabled": true
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "openai-codex": {
        "baseUrl": "https://api.openai.com/v1",
        "auth": "oauth",
        "api": "openai-responses",
        "models": [
          {
            "id": "gpt-5.3-codex",
            "name": "GPT-5.3 Codex",
            "contextWindow": 192000,
            "maxTokens": 65536
          },
          {
            "id": "gpt-5.1-codex-mini",
            "name": "GPT-5.1 Codex Mini",
            "contextWindow": 192000,
            "maxTokens": 65536
          }
        ]
      },
      "openrouter": {
        "baseUrl": "{{ openclaw_openrouter_base_url | default('https://openrouter.ai/api/v1') }}",
        "apiKey": "${OPENROUTER_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek/deepseek-v3.2",
            "name": "DeepSeek V3.2",
            "contextWindow": 163840,
            "maxTokens": 131072
          }
        ]
      },
      "anthropic": {
        "baseUrl": "{{ openclaw_anthropic_base_url | default('https://api.anthropic.com/v1') }}",
        "apiKey": "${ANTHROPIC_API_KEY}",
        "models": [
          {
            "id": "claude-opus-4-6",
            "name": "Claude Opus 4.6",
            "contextWindow": 200000,
            "maxTokens": 32768
          },
          {
            "id": "claude-sonnet-4-6",
            "name": "Claude Sonnet 4.6",
            "contextWindow": 1000000,
            "maxTokens": 32768
          }
        ]
      },
      "openai": {
        "baseUrl": "{{ openclaw_openai_base_url | default('https://api.openai.com/v1') }}",
        "apiKey": "${OPENAI_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "gpt-4o",
            "name": "GPT-4o",
            "contextWindow": 128000,
            "maxTokens": 16384
          }
        ]
      }
    }
  }
}
