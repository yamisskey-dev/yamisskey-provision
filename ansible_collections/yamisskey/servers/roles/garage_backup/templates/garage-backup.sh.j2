#!/bin/bash
# Garage Backup Script - rsync to TrueNAS
# Generated by Ansible - do not edit manually

set -uo pipefail

# Configuration
DATA_DIR="{{ garage_backup_data_dir }}"
META_DIR="{{ garage_backup_meta_dir }}"
TRUENAS_HOST="{{ garage_backup_truenas_host }}"
TRUENAS_USER="{{ garage_backup_truenas_user }}"
TRUENAS_DEST="{{ garage_backup_truenas_dest }}"
SSH_KEY="{{ garage_backup_ssh_key }}"
LOG_DIR="{{ garage_backup_log_dir }}"
{% if garage_backup_bandwidth_limit %}
BANDWIDTH_LIMIT="{{ garage_backup_bandwidth_limit }}"
{% endif %}
{% if garage_backup_discord_webhook_url %}
DISCORD_WEBHOOK_URL="{{ garage_backup_discord_webhook_url }}"
{% endif %}

# Initialize
RSYNC_EXIT=0
DATA_SIZE="unknown"
META_SIZE="unknown"

{% if garage_backup_discord_webhook_url %}
# Discord notification function
send_discord_notification() {
    local status="$1"
    local color="$2"
    local message="$3"

    local payload=$(cat <<EOJSON
{
  "embeds": [{
    "title": "Garage Backup ${status}",
    "description": "${message}",
    "color": ${color},
    "fields": [
      {"name": "Data Dir", "value": "${DATA_DIR}", "inline": true},
      {"name": "Meta Dir", "value": "${META_DIR}", "inline": true},
      {"name": "Destination", "value": "${TRUENAS_HOST}:${TRUENAS_DEST}", "inline": true},
      {"name": "Data Size", "value": "${DATA_SIZE}", "inline": true},
      {"name": "Meta Size", "value": "${META_SIZE}", "inline": true}
    ],
    "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  }]
}
EOJSON
)

    curl -s -H "Content-Type: application/json" -d "$payload" "$DISCORD_WEBHOOK_URL" >/dev/null 2>&1 || true
}
{% endif %}

# Logging
LOG_FILE="${LOG_DIR}/garage-backup-$(date +%Y%m%d-%H%M%S).log"
exec > >(tee -a "$LOG_FILE") 2>&1

echo "========================================"
echo "Garage Backup Started: $(date)"
echo "========================================"
echo "Data: ${DATA_DIR}"
echo "Meta: ${META_DIR}"
echo "Destination: ${TRUENAS_USER}@${TRUENAS_HOST}:${TRUENAS_DEST}"
echo ""

# Check source directories exist
for dir in "$DATA_DIR" "$META_DIR"; do
    if [[ ! -d "$dir" ]]; then
        echo "ERROR: Source directory does not exist: $dir"
{% if garage_backup_discord_webhook_url %}
        send_discord_notification "Failed" "15158332" "Source directory does not exist: $dir"
{% endif %}
        exit 1
    fi
done

# Check SSH connectivity
echo "Checking SSH connectivity..."
if ! ssh -i "$SSH_KEY" -o BatchMode=yes -o IdentitiesOnly=yes -o ConnectTimeout=10 \
    "${TRUENAS_USER}@${TRUENAS_HOST}" "echo 'SSH OK'" >/dev/null 2>&1; then
    echo "ERROR: Cannot connect to TrueNAS via SSH"
{% if garage_backup_discord_webhook_url %}
    send_discord_notification "Failed" "15158332" "Cannot connect to TrueNAS via SSH"
{% endif %}
    exit 1
fi
echo "SSH connection OK"
echo ""

# Get source sizes
DATA_SIZE=$(du -sh "$DATA_DIR" 2>/dev/null | cut -f1)
META_SIZE=$(du -sh "$META_DIR" 2>/dev/null | cut -f1)
echo "Data size: $DATA_SIZE"
echo "Meta size: $META_SIZE"
echo ""

# Build rsync options
RSYNC_OPTS="{{ garage_backup_rsync_opts }}"
{% if garage_backup_bandwidth_limit %}
RSYNC_OPTS="${RSYNC_OPTS} --bwlimit=${BANDWIDTH_LIMIT}"
{% endif %}

# Run rsync for data directory
echo "Starting rsync for data..."
rsync $RSYNC_OPTS \
    -e "ssh -i $SSH_KEY -o BatchMode=yes -o IdentitiesOnly=yes" \
    "$DATA_DIR/" \
    "${TRUENAS_USER}@${TRUENAS_HOST}:${TRUENAS_DEST}/data/"

RSYNC_EXIT=$?

if [[ $RSYNC_EXIT -ne 0 ]]; then
    echo "ERROR: Data rsync failed with exit code: $RSYNC_EXIT"
{% if garage_backup_discord_webhook_url %}
    send_discord_notification "Failed" "15158332" "Data backup failed with exit code: $RSYNC_EXIT"
{% endif %}
    exit $RSYNC_EXIT
fi

# Create LMDB-safe snapshot of metadata before rsync.
# Garage writes to LMDB files continuously; rsyncing live DB files produces
# corrupted backups and exit code 23. mdb_copy creates a consistent hot copy.
SNAPSHOT_DIR=$(mktemp -d)
cleanup_snapshot() { rm -rf "$SNAPSHOT_DIR"; }
trap cleanup_snapshot EXIT

echo ""
echo "Creating LMDB-safe metadata snapshot..."

# Copy non-LMDB files (node keys, config, etc.)
rsync -a --exclude='data.mdb' --exclude='lock.mdb' "$META_DIR/" "$SNAPSHOT_DIR/"

# Hot-copy each LMDB environment
LMDB_COUNT=0
while IFS= read -r -d '' mdb_file; do
    env_dir=$(dirname "$mdb_file")
    rel_path="${env_dir#"$META_DIR"}"
    dest_dir="$SNAPSHOT_DIR${rel_path}"
    mkdir -p "$dest_dir"
    echo "  mdb_copy: .${rel_path:-/}"
    if ! mdb_copy "$env_dir" "$dest_dir"; then
        echo "ERROR: mdb_copy failed for $env_dir"
{% if garage_backup_discord_webhook_url %}
        send_discord_notification "Failed" "15158332" "mdb_copy failed for $env_dir"
{% endif %}
        exit 1
    fi
    LMDB_COUNT=$((LMDB_COUNT + 1))
done < <(find "$META_DIR" -name "data.mdb" -print0)

echo "  Snapshot complete ($LMDB_COUNT LMDB environments)"
echo ""

# Run rsync for metadata snapshot
echo "Starting rsync for metadata..."
rsync $RSYNC_OPTS \
    -e "ssh -i $SSH_KEY -o BatchMode=yes -o IdentitiesOnly=yes" \
    "$SNAPSHOT_DIR/" \
    "${TRUENAS_USER}@${TRUENAS_HOST}:${TRUENAS_DEST}/meta/"

RSYNC_EXIT=$?

echo ""
if [[ $RSYNC_EXIT -eq 0 ]]; then
    echo "========================================"
    echo "Backup completed successfully: $(date)"
    echo "========================================"
{% if garage_backup_discord_webhook_url %}
    send_discord_notification "Success" "3066993" "Backup completed successfully"
{% endif %}
else
    echo "========================================"
    echo "Metadata backup FAILED with exit code: $RSYNC_EXIT"
    echo "========================================"
{% if garage_backup_discord_webhook_url %}
    send_discord_notification "Failed" "15158332" "Metadata backup failed with exit code: $RSYNC_EXIT"
{% endif %}
fi

# Cleanup old logs (keep 30 days)
find "$LOG_DIR" -name "garage-backup-*.log" -mtime +30 -delete 2>/dev/null || true

echo "Log saved to: $LOG_FILE"

exit $RSYNC_EXIT
