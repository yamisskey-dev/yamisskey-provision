services:
  mcaptcha:
    restart: always
    image: mcaptcha/mcaptcha:latest
    networks:
      - mcaptcha_network
      - external_network
    ports:
      - 7493:7493
    env_file:
      - .env-docker-compose
    environment:
      RUST_LOG: "info"
    depends_on:
      mcaptcha_postgres:
        condition: service_healthy
      mcaptcha_redis:
        condition: service_healthy
    healthcheck:
      test: "curl -sf http://localhost:7493/ || exit 1"
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s

  mcaptcha_postgres:
    restart: always
    image: postgres:15-alpine
    networks:
      - mcaptcha_network
    environment:
      POSTGRES_USER: "{{ mcaptcha_postgres_user }}"
      POSTGRES_PASSWORD: "{{ mcaptcha_postgres_password }}"
      POSTGRES_DB: "{{ mcaptcha_postgres_db }}"
    volumes:
      - {{ mcaptcha_dir }}/mcaptcha_db:/var/lib/postgresql/data
    healthcheck:
      test: "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"
      interval: 5s
      retries: 20

  mcaptcha_redis:
    restart: always
    image: mcaptcha/cache:latest
    networks:
      - mcaptcha_network
    healthcheck:
      test: "redis-cli ping"
      interval: 5s
      retries: 20

networks:
  mcaptcha_network:
    internal: true
  external_network:
    external: true
