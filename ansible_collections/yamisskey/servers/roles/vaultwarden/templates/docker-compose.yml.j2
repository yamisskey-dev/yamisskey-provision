# {{ ansible_managed }}
services:
  vaultwarden:
    image: {{ vaultwarden_image }}
    container_name: vaultwarden
    restart: unless-stopped
    environment:
      - DOMAIN=https://{{ vaultwarden_domain }}
      - SIGNUPS_ALLOWED={{ vaultwarden_signups_allowed | bool | lower }}
      # `$` must be doubled for compose interpolation (argon2 PHC hashes contain it)
      - ADMIN_TOKEN={{ vaultwarden_admin_token | replace('$', '$$') }}
      - ROCKET_PORT=80
      - ROCKET_ADDRESS=0.0.0.0
    volumes:
      - ./vw-data:/data
    ports:
      - "{{ vaultwarden_bind }}:{{ vaultwarden_port }}:80"
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
